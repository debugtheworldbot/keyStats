{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystats.app/contracts/sync/v1/encrypted-record.schema.json",
  "title": "KeyStats EncryptedSyncRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "deviceId",
    "revision",
    "nonce",
    "ciphertext",
    "tag",
    "ciphertextHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Unpadded base64url HMAC-SHA256 record index."
    },
    "deviceId": { "type": "string", "format": "uuid" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Limited to the interoperable JSON safe-integer range."
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{16}$",
      "description": "Canonical base64 encoding of the random 96-bit AES-GCM nonce."
    },
    "ciphertext": {
      "type": "string",
      "minLength": 4,
      "maxLength": 87384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{22}==$",
      "description": "Canonical base64 encoding of the 128-bit AES-GCM authentication tag."
    },
    "ciphertextHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Unpadded base64url SHA-256 of nonce || ciphertext || tag."
    }
  }
}
