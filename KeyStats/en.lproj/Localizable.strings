"settings.section.sync" = "Device Sync";
"sync.window.title" = "Device Sync";
"sync.title" = "End-to-End Encrypted Sync";
"sync.privacy.message" = "Key counts and click totals are encrypted on this Mac before upload. The service cannot read your dates, keys, or statistics.";
"sync.help.button" = "How to use device sync";
"sync.help.title" = "How to Use Device Sync";
"sync.help.instructions" = "1. On the first device, click “Create Sync Group” and store the recovery code safely.\n\n2. On the new device, click “Pair This Device.” Enter its six-digit code on a device already in the group, then confirm the matching security code on both devices.\n\n3. After at least two devices are paired, click “Sync Now” when needed. KeyStats then syncs automatically 24 hours after the last successful sync, with up to one additional hour of staggered delay. If the app was closed or the device asleep when syncing was due, it will sync as soon as possible after launch or wake.\n\nIf no paired device is available, use the recovery code to rejoin the sync group.";
"sync.help.dataTitle" = "What syncs now";
"sync.help.dataIncluded" = "• Daily key-press totals and cumulative counts for each key or key combination\n• Daily left, right, middle, back, and forward mouse-button clicks\n• Encrypted device name and platform for the device list";
"sync.help.dataExcluded" = "Not synced: typed content or key order, mouse position or movement distance, scroll distance, and per-app statistics.";
