<Window x:Class="KeyStats.Views.YearReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyStats.Views.Controls"
        xmlns:p="clr-namespace:KeyStats.Properties"
        Title="{x:Static p:Strings.YearReview_WindowTitle}"
        Width="940"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- 主标签页：选中态用强调色实底，和次级切换拉开层级 -->
        <Style x:Key="YearReviewTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级切换：选中态白底 + 强调色描边和文字 -->
        <Style x:Key="YearReviewSegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentContainer" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <Style x:Key="SummaryDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{x:Static p:Strings.YearReview_HeaderTitle}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{x:Static p:Strings.YearReview_HeaderSubtitle}"
                       Margin="0,4,0,12" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Border Style="{StaticResource SegmentContainer}"
                    HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WallTabButton" Content="{x:Static p:Strings.YearReview_TabWall}" GroupName="YearReviewTab"
                                 Style="{StaticResource YearReviewTabButton}" IsChecked="True"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="PersonaTabButton" Content="{x:Static p:Strings.YearReview_TabPersona}" GroupName="YearReviewTab"
                                 Style="{StaticResource YearReviewTabButton}"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="HourlyTabButton" Content="{x:Static p:Strings.YearReview_TabHourly}" GroupName="YearReviewTab"
                                 Style="{StaticResource YearReviewTabButton}"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="AchievementsTabButton" Content="{x:Static p:Strings.YearReview_TabAchievements}" GroupName="YearReviewTab"
                                 Style="{StaticResource YearReviewTabButton}"
                                 Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <!-- 贡献墙 -->
            <StackPanel x:Name="WallPanel">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentContainer}" HorizontalAlignment="Left">
                        <StackPanel x:Name="WallRangePanel" Orientation="Horizontal"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SegmentContainer}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MetricKeysButton" Content="{x:Static p:Strings.YearReview_MetricKeys}" GroupName="YearReviewMetric"
                                         Style="{StaticResource YearReviewSegmentButton}" IsChecked="True"
                                         Checked="Metric_Checked"/>
                            <RadioButton x:Name="MetricClicksButton" Content="{x:Static p:Strings.YearReview_MetricClicks}" GroupName="YearReviewMetric"
                                         Style="{StaticResource YearReviewSegmentButton}"
                                         Checked="Metric_Checked"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Columns="5" Margin="-4,0,-4,10">
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.YearReview_Total}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="TotalValueText" Style="{StaticResource SummaryValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.YearReview_ActiveDays}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="ActiveDaysValueText" Style="{StaticResource SummaryValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.YearReview_CurrentStreak}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="CurrentStreakValueText" Style="{StaticResource SummaryValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.YearReview_LongestStreak}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="LongestStreakValueText" Style="{StaticResource SummaryValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.YearReview_BestDay}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="BestDayValueText" Style="{StaticResource SummaryValue}"/>
                            <TextBlock x:Name="BestDayDetailText" Style="{StaticResource SummaryDetail}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{DynamicResource CardBorder}" Padding="16,14">
                    <controls:ContributionWallControl x:Name="ContributionWall"/>
                </Border>
            </StackPanel>

            <!-- 键盘人格 -->
            <StackPanel x:Name="PersonaPanel" Visibility="Collapsed">
                <Border Style="{StaticResource SegmentContainer}"
                        HorizontalAlignment="Left" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{x:Static p:Strings.History_Range_Today}" GroupName="PersonaRange" Tag="0"
                                     Style="{StaticResource YearReviewSegmentButton}"
                                     Checked="PersonaRange_Checked"/>
                        <RadioButton Content="{x:Static p:Strings.History_Range_Last7Days}" GroupName="PersonaRange" Tag="1"
                                     Style="{StaticResource YearReviewSegmentButton}"
                                     Checked="PersonaRange_Checked"/>
                        <RadioButton x:Name="PersonaMonthButton" Content="{x:Static p:Strings.History_Range_Last30Days}" GroupName="PersonaRange" Tag="2"
                                     Style="{StaticResource YearReviewSegmentButton}"
                                     Checked="PersonaRange_Checked"/>
                        <RadioButton Content="{x:Static p:Strings.History_Range_All}" GroupName="PersonaRange" Tag="3"
                                     Style="{StaticResource YearReviewSegmentButton}"
                                     Checked="PersonaRange_Checked"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="20,16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{x:Static p:Strings.YearReview_PersonaLabel}" Style="{DynamicResource SecondaryText}"/>
                        <TextBlock x:Name="PersonaTitleText" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PersonaDescText" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="PersonaTagsList" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,3" Margin="0,0,6,0"
                                            Background="{DynamicResource SubtleFillBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PersonaTotalsText" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="PersonaMetricsList" Margin="-4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardBorder}" Padding="14,10" Margin="4,0,4,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SecondaryText}"/>
                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 活跃时段 -->
            <StackPanel x:Name="HourlyPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentContainer}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{x:Static p:Strings.History_Range_Today}" GroupName="HourlyRange" Tag="0"
                                         Style="{StaticResource YearReviewSegmentButton}" Checked="HourlyRange_Checked"/>
                            <RadioButton Content="{x:Static p:Strings.History_Range_Last7Days}" GroupName="HourlyRange" Tag="1"
                                         Style="{StaticResource YearReviewSegmentButton}" Checked="HourlyRange_Checked"/>
                            <RadioButton x:Name="HourlyMonthButton" Content="{x:Static p:Strings.History_Range_Last30Days}" GroupName="HourlyRange" Tag="2"
                                         Style="{StaticResource YearReviewSegmentButton}" Checked="HourlyRange_Checked"/>
                            <RadioButton Content="{x:Static p:Strings.History_Range_All}" GroupName="HourlyRange" Tag="3"
                                         Style="{StaticResource YearReviewSegmentButton}" Checked="HourlyRange_Checked"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SegmentContainer}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="HourlyKeysButton" Content="{x:Static p:Strings.YearReview_MetricKeys}" GroupName="HourlyMetric"
                                         Style="{StaticResource YearReviewSegmentButton}" IsChecked="True" Checked="HourlyMetric_Checked"/>
                            <RadioButton x:Name="HourlyClicksButton" Content="{x:Static p:Strings.YearReview_MetricClicks}" GroupName="HourlyMetric"
                                         Style="{StaticResource YearReviewSegmentButton}" Checked="HourlyMetric_Checked"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Columns="4" Margin="-4,0,-4,10">
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.Hourly_PeakHour}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="HourlyPeakText" Style="{StaticResource SummaryValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.Hourly_Chronotype}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="ChronotypeText" Style="{StaticResource SummaryValue}"/>
                            <TextBlock x:Name="ChronotypeDescText" Style="{StaticResource SummaryDetail}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.Hourly_NightRatio}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="NightRatioText" Style="{StaticResource SummaryValue}"/>
                            <TextBlock Text="22:00–05:00" Style="{StaticResource SummaryDetail}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorder}" Padding="12,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Strings.Hourly_DayCount}" Style="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="HourlyDayCountText" Style="{StaticResource SummaryValue}"/>
                            <TextBlock Text="{x:Static p:Strings.Hourly_DayCountDetail}" Style="{StaticResource SummaryDetail}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{DynamicResource CardBorder}" Padding="16,14">
                    <Grid>
                        <StackPanel x:Name="HourlyChartPanel">
                            <TextBlock Text="{x:Static p:Strings.Hourly_ChartCaption}" Style="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
                            <controls:HourlyActivityChartControl x:Name="HourlyChart"/>
                        </StackPanel>
                        <TextBlock x:Name="HourlyEmptyText" Text="{x:Static p:Strings.Hourly_Empty}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,60" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 成就 -->
            <StackPanel x:Name="AchievementsPanel" Visibility="Collapsed">
                <Border Style="{DynamicResource CardBorder}" Padding="20,14" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AchievementSummaryText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AchievementStreakText" FontSize="13" Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="AchievementsList" Margin="-4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardBorder}" Padding="14,12" Margin="4,0,4,8" Opacity="{Binding CardOpacity}">
                                <StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left"
                                            Background="{Binding BadgeBackground}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,2,0,8"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding UnlockedText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <StackPanel Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Height="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding FilledWidth}"/>
                                                <ColumnDefinition Width="{Binding RemainingWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource DividerBrush}"/>
                                            <Border CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
