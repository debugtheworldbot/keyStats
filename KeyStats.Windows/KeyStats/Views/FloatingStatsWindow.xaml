<Window x:Class="KeyStats.Views.FloatingStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:KeyStats.Properties"
        Title="{x:Static p:Strings.FloatingStats_WindowTitle}"
        Width="136"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="RootBorder"
            Background="{DynamicResource TrayBackdropTintBrush}"
            BorderBrush="{DynamicResource TrayPopupBorderBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Cursor="SizeAll"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid Margin="6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding PrimaryValue}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       ToolTip="{Binding PrimaryFullValue}"/>

            <Border Grid.Column="1"
                    Width="0.5"
                    Height="18"
                    Background="{DynamicResource DividerBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding SecondaryValue}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       ToolTip="{Binding SecondaryFullValue}"/>
        </Grid>
    </Border>
</Window>
